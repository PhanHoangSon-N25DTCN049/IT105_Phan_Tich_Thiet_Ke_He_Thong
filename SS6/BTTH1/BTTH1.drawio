        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% Actor\n    Actor([\&quot;Khách hàng (Actor)\&quot;])\n\n    %% System Boundary\n    subgraph System [Hệ thống ATM RikkeiBank]\n        UC1([Rút tiền])\n        UC2([Đăng nhập])\n        UC3([In hóa đơn giao dịch])\n        UC4([Rút tiền tiêu chuẩn])\n        UC5([Rút tiền nhanh])\n    end\n\n    %% Các mối quan hệ\n    Actor --- UC1\n    \n    %% Quan hệ Include (Base -&gt; Included)\n    UC1 -. \&quot;&lt;&lt;include&gt;&gt;\&quot; .-&gt; UC2\n    \n    %% Quan hệ Extend (Extending -&gt; Base)\n    UC3 -. \&quot;&lt;&lt;extend&gt;&gt;\&quot; .-&gt; UC1\n    \n    %% Quan hệ Generalization (Child -&gt; Parent)\n    UC4 --&gt;|\&quot;&lt;&lt;generalization&gt;&gt;\&quot;| UC1\n    UC5 --&gt;|\&quot;&lt;&lt;generalization&gt;&gt;\&quot;| UC1\n    \n    %% Định dạng cho Actor\n    classDef actor fill:#fff,stroke:#333,stroke-width:2px;\n    class Actor actor;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="p7aaSCJFN7KNmSAKSVxG-45">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
